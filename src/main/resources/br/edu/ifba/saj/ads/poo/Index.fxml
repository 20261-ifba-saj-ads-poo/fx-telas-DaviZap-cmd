<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="pane" prefHeight="400.0" prefWidth="600.0"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="br.edu.ifba.saj.ads.poo.IndexController">
   <bottom>
      <HBox alignment="CENTER" prefHeight="35.0" spacing="10.0"
            style="-fx-background-color: steelblue;" BorderPane.alignment="CENTER">
         <Button onAction="#abrirCadastrarHotel" prefWidth="130.0" text="Cadastrar Hotel" />
         <Button onAction="#abrirCadastrarQuarto" prefWidth="130.0" text="Cadastrar Quarto" />
         <Button onAction="#abrirReservar" prefWidth="130.0" text="Fazer Reserva" />
      </HBox>
   </bottom>
</BorderPane>
