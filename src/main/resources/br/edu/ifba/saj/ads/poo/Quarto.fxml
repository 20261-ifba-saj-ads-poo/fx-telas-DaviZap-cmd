<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="244.0" prefWidth="600.0"
    xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="br.edu.ifba.saj.ads.poo.QuartoController">
   <children>
      <Label alignment="CENTER" prefWidth="600.0" text="Cadastro de Quartos"
             AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <font><Font size="35.0"/></font>
      </Label>
      <Label layoutX="14.0" layoutY="56.0" text="Hotel:" />
      <ChoiceBox fx:id="slHotel" layoutY="52.0"
                 AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="52.0"/>
      <Label layoutX="14.0" layoutY="92.0" text="Número:" />
      <TextField fx:id="txNumero" layoutY="88.0"
                 AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="88.0"/>
      <Label layoutX="14.0" layoutY="128.0" text="Categoria:" />
      <ChoiceBox fx:id="slCategoria" layoutY="124.0"
                 AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="124.0"/>
      <Button defaultButton="true" onAction="#salvar" text="Salvar"
              AnchorPane.rightAnchor="14.0" AnchorPane.bottomAnchor="14.0"/>
   </children>
</AnchorPane>
